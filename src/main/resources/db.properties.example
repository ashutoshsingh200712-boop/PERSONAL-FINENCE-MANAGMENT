# Database Configuration Template for MySQL 8
# Copy this file to db.properties or set environment variables:
#   DB_URL, DB_USER, DB_PASSWORD
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/finance_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.username=root
db.password=your_mysql_password_here

# Connection Timeout (ms)
db.connection.timeout=5000
