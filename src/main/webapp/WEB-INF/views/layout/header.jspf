<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.fmt.core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${empty pageTitle ? 'Personal Finance Platform' : pageTitle}"/> - FinApp AI</title>
    <!-- Google Fonts & Bootstrap 5.3 CDN -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar Backdrop for Mobile Drawer -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Sidebar Include -->
        <%@ include file="/WEB-INF/views/layout/sidebar.jspf" %>

        <!-- App Main Container -->
        <div class="app-main">
            <!-- App Topbar -->
            <header class="app-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle Navigation">☰</button>
                    <h1 class="page-title"><c:out value="${empty pageTitle ? 'Financial Management' : pageTitle}"/></h1>
                    <c:if test="${not empty overallStatus}">
                        <c:choose>
                            <c:when test="${overallStatus == 'UNDER'}">
                                <span class="badge badge-status status-under ms-2">Pace: UNDER (Surplus)</span>
                            </c:when>
                            <c:when test="${overallStatus == 'OVER'}">
                                <span class="badge badge-status status-over ms-2">Pace: OVER (Pacing High)</span>
                            </c:when>
                            <c:otherwise>
                                <span class="badge badge-status status-ontrack ms-2">Pace: ON_TRACK</span>
                            </c:otherwise>
                        </c:choose>
                    </c:if>
                </div>

                <div class="topbar-right">
                    <!-- Notification Bell & Popover -->
                    <div class="dropdown">
                        <button class="icon-btn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                            <span>🔔</span>
                            <c:if test="${not empty notifications && notifications.size() > 0}">
                                <span class="icon-badge"><c:out value="${notifications.size()}"/></span>
                            </c:if>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2" style="width: 320px;">
                            <li class="dropdown-header fw-bold text-dark d-flex justify-content-between align-items-center">
                                <span>Notifications</span>
                                <c:if test="${not empty notifications && notifications.size() > 0}">
                                    <span class="badge bg-danger"><c:out value="${notifications.size()}"/> New</span>
                                </c:if>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <c:choose>
                                <c:when test="${not empty notifications}">
                                    <c:forEach var="notif" items="${notifications}">
                                        <li class="p-2 border-bottom small">
                                            <div class="d-flex justify-content-between">
                                                <strong class="text-dark"><c:out value="${notif.title}"/></strong>
                                                <span class="badge bg-secondary" style="font-size: 0.65rem;"><c:out value="${notif.type}"/></span>
                                            </div>
                                            <span class="text-muted d-block mt-1"><c:out value="${notif.message}"/></span>
                                        </li>
                                    </c:forEach>
                                </c:when>
                                <c:otherwise>
                                    <li class="p-3 text-center text-muted small">No unread notifications.</li>
                                </c:otherwise>
                            </c:choose>
                        </ul>
                    </div>

                    <form action="${pageContext.request.contextPath}/logout" method="post" class="d-inline mb-0">
                        <input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}">
                        <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-3 d-flex align-items-center gap-1" title="Log Out">
                            <span>⎋</span>
                            <span class="d-none d-sm-inline">Log Out</span>
                        </button>
                    </form>
                </div>
            </header>

            <!-- Main App Content -->
            <main class="app-content">
                <!-- Session Flash Messages -->
                <jsp:include page="/WEB-INF/views/common/flash.jsp"/>
